# Kopieer naar terraform.tfvars (staat in .gitignore) en vul in.
scaleway_organization_id = "<organisatie-id, Scaleway-console › Organization › Settings>"
scaleway_project_id      = "<project-id van kleurhoek-dev>"
state_bucket             = "<naam van de state-bucket>"
zitadel_domain           = "dev-xxxxxx.eu1.zitadel.cloud" # tot de lancering dezelfde instance voor dev en prod
zitadel_key_file         = "~/.config/kleurhoek/zitadel-terraform.json"
zitadel_admin_org_id     = "<organisatie-id van Org Beheer>"
zitadel_idp_ids          = []
cloudflare_account_id    = "<account-id>"
cloudflare_zone_id       = "<zone-id van kleurhoek.nl>"
admin_emails             = ["thijs@example.com"]
admin_bootstrap_subjects = ["<jouw Zitadel-gebruikers-id>"]
