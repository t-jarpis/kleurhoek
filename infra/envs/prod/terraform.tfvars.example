# Kopieer naar terraform.tfvars (staat in .gitignore) en vul in.
scaleway_organization_id = "<organisatie-id, Scaleway-console › Organization › Settings>"
scaleway_project_id      = "<project-id van kleurhoek-prod>"
state_bucket             = "<naam van de state-bucket>"
zitadel_domain           = "dev-xxxxxx.eu1.zitadel.cloud" # tot de lancering dezelfde instance voor dev en prod
zitadel_key_file         = "~/.config/kleurhoek/zitadel-terraform.json"
zitadel_admin_org_id     = "<organisatie-id van Org Beheer>"
zitadel_idp_ids          = []
cloudflare_account_id    = "<account-id>"
cloudflare_zone_id       = "<zone-id van kleurhoek.nl>"
admin_emails             = ["thijs@example.com"]
admin_bootstrap_subjects = ["<jouw Zitadel-gebruikers-id>"]
# Mail (ADR 0037). Leeg = versturen staat uit; mails wachten dan tot 3 dagen in de wachtrij.
# smtp_url: nieuwsbrief en automatische mails (bulk); transactional_smtp_url: bevestigingsmails (leeg = smtp_url).
# mail = {
#   from                   = "Kleurhoek <hallo@kleurhoek.nl>"
#   smtp_url               = "smtp://<gebruiker>:<wachtwoord>@<host>:587"
#   transactional_smtp_url = "smtp://<project-id>:<sleutel>@smtp.tem.scaleway.com:587"
# }
# Zoekcijfers (ADR 0041): JSON-sleutel van het Google-serviceaccount (bestand buiten de repo) en de Bing-API-sleutel.
# search = {
#   google_key_file = "~/.config/kleurhoek/search-console.json"
#   bing_api_key    = "<Bing Webmaster Tools › Instellingen › API-toegang>"
# }
# Social (ADR 0063): apps op developers.pinterest.com en developers.facebook.com. Terugkeeradressen:
# https://<admin-host>/social/koppel/pinterest en https://<admin-host>/social/koppel/meta
# social = {
#   pinterest_app_id     = "<App ID>"
#   pinterest_app_secret = "<App secret key>"
#   meta_app_id          = "<App-ID>"
#   meta_app_secret      = "<App-geheim>"
# }
