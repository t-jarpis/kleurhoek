# Lokaal ontwikkelen. Kopieer naar .env.local per app; nooit committen.
NODE_ENV=development
DEV_COUNTRY=NL

# --- API (apps/api) ---
INGEST_KEY=dev-only-ingest-key-change-me-0000000000
# Alleen zonder Zitadel: vaste beheerderstoken (minstens 32 tekens). Verboden in productie.
ADMIN_DEV_TOKEN=verander-mij-minstens-32-tekens-lang-000000
# Inloggen via Zitadel (in productie verplicht)
# OIDC_ISSUER=https://login.kleurhoek.nl
# OIDC_AUDIENCE=<project-id van Kleurhoek>
# ADMIN_ORG_ID=<organisatie-id van Org Beheer>
# SITE_ORG_ID=<organisatie-id van Kleurhoek>
# ADMIN_BOOTSTRAP_SUBJECTS=<jouw Zitadel-gebruikers-id>

# --- Website (apps/web) ---
API_URL=http://localhost:3001
ANALYTICS_SALT_SECRET=verander-mij
# OIDC_ISSUER=https://login.kleurhoek.nl
# OIDC_CLIENT_ID=<client-id van de app "Kleurhoek web">
# OIDC_CLIENT_SECRET=<geheim, uit Key Vault>
# OIDC_PROJECT_ID=<project-id van Kleurhoek>
# OIDC_ORG_ID=<organisatie-id van Kleurhoek>
# SITE_URL=http://localhost:3000
# SESSION_SECRET=<minstens 32 willekeurige tekens>

# --- Admin panel (apps/admin) ---
# OIDC_ISSUER=https://login.kleurhoek.nl
# OIDC_CLIENT_ID=<client-id van de app "Kleurhoek admin">
# OIDC_CLIENT_SECRET=<geheim, uit Key Vault>
# OIDC_PROJECT_ID=<project-id van Kleurhoek>
# ADMIN_ORG_ID=<organisatie-id van Org Beheer>
# ADMIN_URL=http://localhost:3002
# SESSION_SECRET=<ander geheim dan de website>
